{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "(.claude/hooks/ai-room-ensure-codex-roles.sh &)"
          },
          {
            "type": "command",
            "command": ".claude/hooks/ai-room-session-brief.sh"
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/post-compact-directive.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Monitor",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/enforce-watch-wrap.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/enforce-monitor-on-bg-shell.sh"
          }
        ]
      },
      {
        "matcher": "mcp__ai-room__ai_room_post|mcp__ai-room__ai_room_reply|mcp__ai_room__ai_room_post|mcp__ai_room__ai_room_reply",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/at_gabe_askuserquestion_gate.py"
          },
          {
            "type": "command",
            "command": ".claude/hooks/task_dispatch_child_boundary_gate.py"
          },
          {
            "type": "command",
            "command": ".claude/hooks/task_dispatch_cross_thread_gate.py"
          },
          {
            "type": "command",
            "command": ".claude/hooks/worker_gate_wake_pairing_gate.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/cross_thread_audit.py"
          }
        ]
      }
    ]
  }
}
