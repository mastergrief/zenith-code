#!/usr/bin/env bash
# claw — launch the Claw Code harness with llama.cpp auto-start
#
# GGUF selection precedence (high → low):
#   1. --gguf PATH (CLI flag, must be first arg)
#   2. CLAW_MODEL env var
#   3. Default: ~/models/gemma-4-E4B-it-Q5_K_M.gguf
#
# Context size precedence (high → low):
#   1. CLAW_CTX env var
#   2. Default: 262144 (256K — both Gemma 4 E4B and Qwen 3.5 4B are trained
#      at this range, fits 8 GB VRAM with Q4 KV cache). The harness then
#      auto-computes its compaction threshold as min(per-model NIAH-validated
#      limit, 85% of server ctx) via agents/compact.py:MODEL_CONTEXT_LIMITS.
#      Requires the patched llama.cpp training-context slot cap removal at
#      tools/server/server-context.cpp:763-766 for extrapolation past trained
#      max; otherwise llama-server silently caps to n_ctx_train.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"

# Consume --gguf PATH if provided as the first argument. Keep it distinct
# from the harness's --model flag, which refers to the Ollama-style model
# name (not a GGUF path).
if [[ "${1:-}" == "--gguf" ]]; then
    if [[ -z "${2:-}" ]]; then
        echo "Error: --gguf requires a path argument" >&2
        exit 1
    fi
    MODEL="$2"
    shift 2
else
    MODEL="${CLAW_MODEL:-$HOME/models/gemma-4-E4B-it-Q5_K_M.gguf}"
fi

# Expand ~ in case the user passed a tilde path
MODEL="${MODEL/#\~/$HOME}"

LLAMA_SERVER="${CLAW_LLAMA_SERVER:-$HOME/llama.cpp/build/bin/llama-server}"
PORT="${CLAW_PORT:-8080}"
CTX="${CLAW_CTX:-262144}"
LLAMA_PID=""
STARTED_LLAMA=false

cleanup() {
    if $STARTED_LLAMA && [ -n "$LLAMA_PID" ]; then
        echo -e "\n  Stopping llama.cpp (pid $LLAMA_PID)..."
        kill "$LLAMA_PID" 2>/dev/null
        wait "$LLAMA_PID" 2>/dev/null
    fi
}
trap cleanup EXIT

# ── Check for model file ──────────────────────────────────────────
if [ ! -f "$MODEL" ]; then
    echo "Error: Model not found at $MODEL"
    echo "Set CLAW_MODEL to your GGUF path"
    exit 1
fi

# ── Check for llama-server binary ─────────────────────────────────
if [ ! -x "$LLAMA_SERVER" ]; then
    echo "Error: llama-server not found at $LLAMA_SERVER"
    echo "Build llama.cpp with: cd ~/llama.cpp && cmake -B build -DGGML_CUDA=ON && cmake --build build -j\$(nproc)"
    exit 1
fi

# ── Start llama.cpp if not running ────────────────────────────────
if curl -s "localhost:$PORT/health" 2>/dev/null | grep -q '"ok"'; then
    echo "  llama.cpp already running on :$PORT"
else
    echo "  Starting llama.cpp on :$PORT..."
    "$LLAMA_SERVER" \
        -m "$MODEL" \
        --ctx-size "$CTX" \
        --parallel 1 \
        --cache-type-k q4_0 \
        --cache-type-v q4_0 \
        -ngl 999 \
        --port "$PORT" \
        > /tmp/llama-server.log 2>&1 &
    LLAMA_PID=$!
    STARTED_LLAMA=true

    # Wait for health (up to 60s for model load + KV cache allocation)
    echo -n "  Waiting for model to load"
    for i in $(seq 1 60); do
        if curl -s "localhost:$PORT/health" 2>/dev/null | grep -q '"ok"'; then
            echo -e "\n  llama.cpp ready (${i}s)"
            break
        fi
        if ! kill -0 "$LLAMA_PID" 2>/dev/null; then
            echo -e "\n  Error: llama.cpp exited. Check /tmp/llama-server.log"
            exit 1
        fi
        echo -n "."
        sleep 1
    done

    if ! curl -s "localhost:$PORT/health" 2>/dev/null | grep -q '"ok"'; then
        echo -e "\n  Error: llama.cpp failed to start within 60s"
        echo "  Check /tmp/llama-server.log"
        exit 1
    fi
fi

# ── Kill Windows Ollama if running (VRAM conflict) ────────────────
# NOTE: redirect stdin from /dev/null — WSL's interop shim forwards parent
# stdin to Windows binaries, which consumes it and breaks programmatic
# `printf ... | claw` invocation. Without this, the harness's first input()
# call gets EOFError and the session exits before reading any prompt.
if command -v tasklist.exe &>/dev/null; then
    if tasklist.exe < /dev/null 2>/dev/null | grep -qi "ollama"; then
        echo "  Warning: Windows Ollama is running — may cause VRAM conflicts"
    fi
fi

# ── Launch harness ────────────────────────────────────────────────
# Don't cd into the repo: that would force CLAUDE.md auto-discovery and
# .clawrc lookup to use the project root instead of the user's actual
# working directory. Use the absolute script path so cwd stays the user's.
PYTHONUTF8=1 PYTHONPATH="$SCRIPT_DIR" exec python3 "$SCRIPT_DIR/agents/harness.py" --backend llamacpp "$@"
