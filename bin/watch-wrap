#!/usr/bin/env python3
"""watch-wrap — enhancement layer for the Monitor tool.

Thin harness: argparse, process spawn, missing-log wait, pid poll.
Stream drain + line policy: scripts/watch_wrap_stream.py (__file__-relative).
"""
from __future__ import annotations

import argparse
import importlib.util
import os
import re
import subprocess
import sys
import threading
import time
from pathlib import Path
from typing import Optional


def _load_stream():
    here = Path(__file__).resolve()
    stream_path = here.parent.parent / "scripts" / "watch_wrap_stream.py"
    spec = importlib.util.spec_from_file_location("watch_wrap_stream", stream_path)
    if spec is None or spec.loader is None:
        raise ImportError(f"cannot load watch_wrap_stream from {stream_path}")
    mod = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = mod
    spec.loader.exec_module(mod)
    return mod


_stream = _load_stream()
build_categories = _stream.build_categories
DrainConfig = _stream.DrainConfig
drain_fd_loop = _stream.drain_fd_loop
emit_replay = _stream.emit_replay


def emit(msg: str, t0: float) -> None:
    elapsed = int(time.time() - t0)
    print(f"[T+{elapsed:>4d}s] {msg}", flush=True)


def wrap_mode(cmd: list[str], t0: float, cats: list, args) -> int:
    """HEAD rc parity: wrapper_rc=0 only when we terminate a still-running child
    after stop-on. Natural exit after the terminal line keeps its natural rc.
    """
    emit(f"[START] {' '.join(cmd)}", t0)
    proc = subprocess.Popen(
        cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, bufsize=0
    )
    assert proc.stdout is not None
    cfg = DrainConfig(
        stop_re=re.compile(args.stop_on) if args.stop_on else None,
        cats=cats,
        heartbeat=float(args.heartbeat or 0),
        coalesce=float(args.coalesce or 0),
        replay=int(args.replay),
        select_cap=60.0,
    )
    stop_observed = False
    terminated_on_stop = False
    try:
        result = drain_fd_loop(
            proc.stdout.fileno(), cfg=cfg, on_event=lambda m: emit(m, t0)
        )
        emit_replay(result.replay, args.replay, lambda m: emit(m, t0))
        stop_observed = bool(result.stop_triggered)
        # HEAD parity: wrapper_rc=0 only when we terminate a still-live child.
        # Brief grace so a child that prints terminal then exits immediately
        # can register natural rc before we SIGTERM (deterministic rc=7 path).
        if stop_observed and proc.poll() is None:
            for _ in range(20):
                if proc.poll() is not None:
                    break
                time.sleep(0.01)
        if stop_observed and proc.poll() is None:
            terminated_on_stop = True
            proc.terminate()
            try:
                rc = proc.wait(timeout=5)
            except subprocess.TimeoutExpired:
                proc.kill()
                rc = proc.wait()
        else:
            rc = proc.wait()
    except KeyboardInterrupt:
        emit("[INTERRUPTED] sending SIGTERM", t0)
        proc.terminate()
        try:
            rc = proc.wait(timeout=5)
        except subprocess.TimeoutExpired:
            proc.kill()
            rc = proc.wait()
        stop_observed = False
        terminated_on_stop = False
    wrapper_rc = 0 if terminated_on_stop else rc
    suffix = " (stop-triggered)" if terminated_on_stop else ""
    emit(f"[EXIT rc={rc}{suffix}] elapsed {int(time.time() - t0)}s", t0)
    return wrapper_rc


def tail_file_mode(path: str, t0: float, cats: list, args) -> int:
    emit(f"[START tail] {path}" + (f" pid={args.pid}" if args.pid else ""), t0)
    for _ in range(100):
        if os.path.exists(path):
            break
        time.sleep(0.1)
    if not os.path.exists(path):
        emit(f"[ERR] log not found: {path}", t0)
        return 2

    proc = subprocess.Popen(
        ["tail", "-F", "-n", "0", path],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        bufsize=0,
    )
    assert proc.stdout is not None
    pid_exit: dict = {"rc": None}

    def watch_pid() -> None:
        if not args.pid:
            return
        while True:
            try:
                os.kill(args.pid, 0)
            except ProcessLookupError:
                pid_exit["rc"] = 0
                break
            except PermissionError:
                pass
            time.sleep(1.0)

    if args.pid:
        threading.Thread(target=watch_pid, daemon=True).start()

    cfg = DrainConfig(
        stop_re=re.compile(args.stop_on) if args.stop_on else None,
        cats=cats,
        heartbeat=float(args.heartbeat or 0),
        coalesce=float(args.coalesce or 0),
        replay=int(args.replay),
        select_cap=5.0 if args.pid else 60.0,
    )

    def should_break() -> Optional[str]:
        if args.pid and pid_exit["rc"] is not None:
            return f"[PID EXIT pid={args.pid}] elapsed {int(time.time() - t0)}s"
        return None

    try:
        result = drain_fd_loop(
            proc.stdout.fileno(),
            cfg=cfg,
            on_event=lambda m: emit(m, t0),
            should_break_external=should_break if args.pid else None,
        )
        emit_replay(result.replay, args.replay, lambda m: emit(m, t0))
    finally:
        proc.terminate()
        try:
            proc.wait(timeout=2)
        except subprocess.TimeoutExpired:
            proc.kill()
    return 0


def main() -> int:
    ap = argparse.ArgumentParser(
        description="Enhancement wrapper for Monitor.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=__doc__,
    )
    ap.add_argument("--log", help="tail existing log file instead of spawning")
    ap.add_argument("--pid", type=int, default=0, help="with --log, poll pid")
    ap.add_argument("--heartbeat", type=int, default=0)
    ap.add_argument("--coalesce", type=float, default=0.0)
    ap.add_argument("--error", default="")
    ap.add_argument("--progress", default="")
    ap.add_argument("--success", default="")
    ap.add_argument("--replay", type=int, default=10)
    ap.add_argument("--stop-on", default="")
    ap.add_argument("cmd", nargs=argparse.REMAINDER)
    args = ap.parse_args()
    cats = build_categories(
        error=args.error, progress=args.progress, success=args.success
    )
    t0 = time.time()
    if args.log:
        return tail_file_mode(args.log, t0, cats, args)
    cmd = args.cmd
    if cmd and cmd[0] == "--":
        cmd = cmd[1:]
    if not cmd:
        ap.print_help(sys.stderr)
        emit("[ERR] need either --log PATH or a command after --", t0)
        return 2
    return wrap_mode(cmd, t0, cats, args)


if __name__ == "__main__":
    sys.exit(main())
