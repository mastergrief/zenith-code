#!/usr/bin/env python3
"""watch-wrap — enhancement layer for the Monitor tool.

Monitor's pain points (from 2026-04-20 usage):
- Silent timeout indistinguishable from clean process exit
- Every matched line burns a notification/context slot
- No heartbeat if a process goes silent
- No category tagging (errors vs progress vs success)
- No replay of recent matches on completion

This wrapper adds all five as a filter layer. Invoke Monitor on the
wrapper's stdout:

    Monitor(command="bin/watch-wrap --heartbeat 120 \\
                      --error 'Traceback|Error|OOM|Killed|assert' \\
                      --progress 'tok/s|epoch' \\
                      -- python3 myscript.py")

Three input modes:
- wrap:  `bin/watch-wrap [flags] -- CMD ARGS...`   — spawn subprocess
- tail:  `bin/watch-wrap [flags] --log PATH`       — tail an existing file
- both:  `bin/watch-wrap [flags] --log PATH --pid N`
           — tail file + poll pid for exit

All output goes to stdout, one event per line. Intended to be piped
to Monitor but also readable by a human via `tail -f`.
"""

from __future__ import annotations

import argparse
import os
import re
import signal
import subprocess
import sys
import time
from collections import deque
from dataclasses import dataclass
from typing import Optional


@dataclass
class Category:
    name: str        # "error" | "progress" | "success" | "other"
    pattern: Optional[re.Pattern]
    prefix: str      # emitted prefix, e.g. "[ERR]"


def build_categories(args) -> list[Category]:
    cats = []
    if args.error:
        cats.append(Category("error", re.compile(args.error), "[ERR]"))
    if args.progress:
        cats.append(Category("progress", re.compile(args.progress), "[PROG]"))
    if args.success:
        cats.append(Category("success", re.compile(args.success), "[OK]"))
    return cats


def classify(line: str, cats: list[Category]) -> tuple[Optional[Category], bool]:
    """Return (matching_category, should_emit). If no category matches AND
    no filter was provided at all, emit as "other". If filters exist but
    none match, skip."""
    for c in cats:
        if c.pattern.search(line):
            return c, True
    if not cats:  # no filter → emit everything as other
        return None, True
    return None, False


def emit(msg: str, t0: float) -> None:
    """Write a structured event line to stdout, flushed."""
    elapsed = int(time.time() - t0)
    print(f"[T+{elapsed:>4d}s] {msg}", flush=True)


def maybe_emit_heartbeat(now: float, last_activity: float, replay: deque,
                          hb_mult: int, hb_last_line: Optional[str],
                          args, t0: float) -> tuple[float, int, Optional[str]]:
    """If silent >= args.heartbeat * hb_mult, emit HEARTBEAT and apply
    exponential backoff on unchanged last-line. Returns new
    (last_activity, hb_mult, hb_last_line)."""
    if not args.heartbeat:
        return last_activity, hb_mult, hb_last_line
    if (now - last_activity) < args.heartbeat * hb_mult:
        return last_activity, hb_mult, hb_last_line
    last_raw = replay[-1] if replay else "<no output yet>"
    suffix = f" (x{hb_mult})" if hb_mult > 1 else ""
    emit(f"[HEARTBEAT{suffix}] silent {int(now-last_activity)}s, "
         f"last: {last_raw[:120]}", t0)
    new_mult = min(hb_mult * 2, 8) if last_raw == hb_last_line else 2
    return now, new_mult, last_raw


def _check_stop(line: str, stop_re: Optional[re.Pattern], t0: float) -> bool:
    """Return True if line matches the stop pattern (caller should exit)."""
    if stop_re and stop_re.search(line):
        emit(f"[STOP-TRIGGER] {line}", t0)
        return True
    return False


class RawFdLinePump:
    """Raw-FD pending-line pump shared by wrap and tail-file modes.

    NEVER pair TextIOWrapper.readline() with select(fd) — multi-line bursts
    leave later lines in the Python buffer while the FD looks idle.
    """
    __slots__ = ("fd", "byte_buf", "pending")

    def __init__(self, fd: int):
        self.fd = fd
        self.byte_buf = b""
        self.pending: list[str] = []

    def ingest(self, data: bytes) -> None:
        self.byte_buf += data
        while b"\n" in self.byte_buf:
            line, self.byte_buf = self.byte_buf.split(b"\n", 1)
            self.pending.append(line.decode(errors="replace").rstrip("\r"))

    def read_chunk(self) -> bool:
        """Read once from fd. False = EOF (flush partial remainder)."""
        try:
            chunk = os.read(self.fd, 65536)
        except OSError:
            chunk = b""
        if not chunk:
            if self.byte_buf.strip():
                self.pending.append(
                    self.byte_buf.decode(errors="replace").rstrip("\r"))
                self.byte_buf = b""
            return False
        self.ingest(chunk)
        return True


def _process_line(line: str, now: float, cats, args, stop_re, t0,
                  coalesce_buf, coalesce_start, replay, last_activity,
                  hb_mult, hb_last_line):
    """Classify/emit one line; return updated state + stop_hit."""
    if not line:
        return (coalesce_buf, coalesce_start, last_activity, hb_mult,
                hb_last_line, False)
    replay.append(line)
    hb_mult, hb_last_line = 1, None
    cat, should_emit = classify(line, cats)
    if should_emit:
        if cat and cat.name == "error":
            emit(f"{cat.prefix} {line}", t0)
        elif args.coalesce:
            if coalesce_start is None:
                coalesce_start = now
            coalesce_buf.append((cat, line))
        else:
            prefix = cat.prefix if cat else "[OTHER]"
            emit(f"{prefix} {line}", t0)
    stop_hit = _check_stop(line, stop_re, t0)
    if stop_hit and coalesce_buf:
        c, ll = coalesce_buf[-1]
        pfx = c.prefix if c else "[OTHER]"
        emit(f"[COALESCED x{len(coalesce_buf)}] {pfx} {ll}", t0)
        coalesce_buf = []
    return (coalesce_buf, coalesce_start, now, hb_mult, hb_last_line, stop_hit)


def _flush_coalesce(coalesce_buf, t0) -> list:
    if not coalesce_buf:
        return []
    cat, last_line = coalesce_buf[-1]
    prefix = cat.prefix if cat else "[OTHER]"
    count = len(coalesce_buf)
    if count == 1:
        emit(f"{prefix} {last_line}", t0)
    else:
        emit(f"[COALESCED x{count}] {prefix} {last_line}", t0)
    return []


def _replay_if(replay, args, t0) -> None:
    if replay and args.replay > 0:
        emit(f"[REPLAY last {len(replay)} lines]", t0)
        for r in replay:
            print(f"  {r}", flush=True)


def tail_events(fd: int, t0: float, cats: list[Category], args,
                *, max_wait: float = 60.0, break_check=None) -> None:
    """Shared select+pump loop for wrap stdout and tail -F pipes."""
    import select
    pump = RawFdLinePump(fd)
    last_activity = time.time()
    coalesce_buf: list[tuple[Optional[Category], str]] = []
    coalesce_start = None
    replay: deque[str] = deque(maxlen=max(1, args.replay))
    hb_mult = 1
    hb_last_line = None
    stop_re = re.compile(args.stop_on) if args.stop_on else None
    eof = False

    while True:
        if break_check is not None and break_check():
            break
        now = time.time()
        timeout_parts = []
        if args.heartbeat:
            timeout_parts.append(args.heartbeat * hb_mult - (now - last_activity))
        if args.coalesce and coalesce_start is not None:
            timeout_parts.append(args.coalesce - (now - coalesce_start))
        wait = min([t for t in timeout_parts if t > 0], default=1.0)
        wait = max(0.1, min(wait, max_wait))

        # Process buffered complete lines before select (critical).
        if not pump.pending:
            ready, _, _ = select.select([fd], [], [], wait)
            now = time.time()
            if ready:
                if not pump.read_chunk():
                    eof = True
                    if not pump.pending:
                        break
            else:
                ready = False
        else:
            now = time.time()
            ready = True

        if (coalesce_start is not None and args.coalesce
                and (now - coalesce_start) >= args.coalesce):
            coalesce_buf = _flush_coalesce(coalesce_buf, t0)
            coalesce_start = None

        if not ready and not pump.pending:
            last_activity, hb_mult, hb_last_line = maybe_emit_heartbeat(
                now, last_activity, replay, hb_mult, hb_last_line, args, t0)
            if eof:
                break
            continue
        if not pump.pending:
            if eof:
                break
            continue

        line = pump.pending.pop(0)
        (coalesce_buf, coalesce_start, last_activity,
         hb_mult, hb_last_line, stop_hit) = _process_line(
            line, now, cats, args, stop_re, t0, coalesce_buf, coalesce_start,
            replay, last_activity, hb_mult, hb_last_line)
        if stop_hit:
            break

    coalesce_buf = _flush_coalesce(coalesce_buf, t0)
    _replay_if(replay, args, t0)


def tail_loop(stream, t0: float, cats: list[Category], args) -> None:
    """Read lines from stream until EOF. Uses shared RawFdLinePump."""
    tail_events(stream.fileno(), t0, cats, args, max_wait=60.0)


def wrap_mode(cmd: list[str], t0: float, cats: list[Category], args) -> int:
    """Spawn subprocess, merge stderr into stdout, tail it, report exit."""
    emit(f"[START] {' '.join(cmd)}", t0)
    proc = subprocess.Popen(
        cmd,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        bufsize=1,
        text=True,
    )
    stop_triggered = False
    try:
        tail_loop(proc.stdout, t0, cats, args)
        if proc.poll() is None:
            stop_triggered = True
            proc.terminate()
            try:
                rc = proc.wait(timeout=5)
            except subprocess.TimeoutExpired:
                proc.kill()
                rc = proc.wait()
        else:
            rc = proc.wait()
    except KeyboardInterrupt:
        emit("[INTERRUPTED] sending SIGTERM", t0)
        proc.terminate()
        try:
            rc = proc.wait(timeout=5)
        except subprocess.TimeoutExpired:
            proc.kill()
            rc = proc.wait()
    wrapper_rc = 0 if stop_triggered else rc
    emit(f"[EXIT rc={rc}{' (stop-triggered)' if stop_triggered else ''}] "
         f"elapsed {int(time.time()-t0)}s", t0)
    return wrapper_rc


def tail_file_mode(path: str, t0: float, cats: list[Category], args) -> int:
    """Tail an existing log file. Optionally poll --pid for exit."""
    emit(f"[START tail] {path}"
         + (f" pid={args.pid}" if args.pid else ""), t0)

    for _ in range(100):
        if os.path.exists(path):
            break
        time.sleep(0.1)
    if not os.path.exists(path):
        emit(f"[ERR] log not found: {path}", t0)
        return 2

    proc = subprocess.Popen(
        ["tail", "-F", "-n", "0", path],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        bufsize=1,
        text=True,
    )

    import threading
    pid_exit: dict = {"rc": None}

    def watch_pid():
        if not args.pid:
            return
        while True:
            try:
                os.kill(args.pid, 0)
            except ProcessLookupError:
                pid_exit["rc"] = 0
                break
            except PermissionError:
                pass
            time.sleep(1.0)

    if args.pid:
        threading.Thread(target=watch_pid, daemon=True).start()

    def break_check():
        if args.pid and pid_exit["rc"] is not None:
            emit(f"[PID EXIT pid={args.pid}] elapsed "
                 f"{int(time.time()-t0)}s", t0)
            return True
        return False

    try:
        tail_events(proc.stdout.fileno(), t0, cats, args,
                    max_wait=5.0, break_check=break_check)
    finally:
        proc.terminate()
        try:
            proc.wait(timeout=2)
        except subprocess.TimeoutExpired:
            proc.kill()

    return 0



def main() -> int:
    ap = argparse.ArgumentParser(
        description="Enhancement wrapper for Monitor.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=__doc__,
    )
    ap.add_argument("--log", help="tail existing log file instead of "
                                    "spawning a command")
    ap.add_argument("--pid", type=int, default=0,
                    help="with --log, also poll this pid and emit "
                         "[PID EXIT] when it dies")
    ap.add_argument("--heartbeat", type=int, default=0,
                    help="emit [HEARTBEAT] if silent N sec (0=off)")
    ap.add_argument("--coalesce", type=float, default=0.0,
                    help="group matching lines within N sec into "
                         "[COALESCED xK] events (0=off)")
    ap.add_argument("--error", default="",
                    help="regex for [ERR]-tagged lines — always emitted, "
                         "never coalesced")
    ap.add_argument("--progress", default="",
                    help="regex for [PROG]-tagged lines")
    ap.add_argument("--success", default="",
                    help="regex for [OK]-tagged lines")
    ap.add_argument("--replay", type=int, default=10,
                    help="on completion, re-emit last N matched lines "
                         "(default 10)")
    ap.add_argument("--stop-on", default="",
                    help="regex — when a line matches, emit [STOP-TRIGGER] "
                         "and exit cleanly. Useful for tail-file mode "
                         "where the process doesn't die (e.g. 'DONE$' "
                         "for gemma daemon script completion)")
    ap.add_argument("cmd", nargs=argparse.REMAINDER,
                    help="command + args to wrap (everything after --)")
    args = ap.parse_args()

    cats = build_categories(args)
    t0 = time.time()

    if args.log:
        return tail_file_mode(args.log, t0, cats, args)

    # Wrap mode: command after optional "--"
    cmd = args.cmd
    if cmd and cmd[0] == "--":
        cmd = cmd[1:]
    if not cmd:
        ap.print_help(sys.stderr)
        emit("[ERR] need either --log PATH or a command after --", t0)
        return 2

    return wrap_mode(cmd, t0, cats, args)


if __name__ == "__main__":
    sys.exit(main())
