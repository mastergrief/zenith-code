      %abs_val_1 = arith.subi %c0_i64, %val_0 : i64 loc(#loc24)
      %abs_val_2 = arith.select %abs_val, %abs_val_1, %val_0 : i64 loc(#loc25)
      %rounded = arith.addi %abs_val_2, %c128_i64 : i64 loc(#loc26)
      %rounded_3 = arith.shrsi %rounded, %c8_i64 : i64 loc(#loc27)
      %rescaled = arith.subi %c0_i64, %rounded_3 : i64 loc(#loc28)
      %rescaled_4 = arith.select %positive, %rounded_3, %rescaled : i64 loc(#loc29)
      %0 = tt.addptr %OUT_PTR, %i : !tt.ptr<i32>, i32 loc(#loc13)
      %1 = arith.trunci %rescaled_4 : i64 to i32 loc(#loc14)
      tt.store %0, %1 : !tt.ptr<i32> loc(#loc15)
    } loc(#loc2)
    tt.return loc(#loc16)
  } loc(#loc)
