    %c0_i32 = arith.constant 0 : i32 loc(#loc2)
    %c1_i32 = arith.constant 1 : i32 loc(#loc2)
    scf.for %i = %c0_i32 to %I step %c1_i32  : i32 {
      %val = tt.addptr %ACC_PTR, %i : !tt.ptr<i64>, i32 loc(#loc20)
      %val_0 = tt.load %val : !tt.ptr<i64> loc(#loc21)
